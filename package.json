{
  "name": "granite-ridge-water",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build-data": "tsx scripts/build-data.ts && tsx scripts/write-rain-csv.ts",
    "dev": "npm run build-data && vite",
